Project banco_sangre {
  database_type: 'MySQL'
  Note: 'Banco de Sangre - Modelo relacional completo'
}

// ==========================================
// ENUMERACIONES
// ==========================================

Enum sexo {
  F
  M
  X
}

Enum tipo_sangre {
  A
  B
  AB
  O
}

Enum factor_rh {
  positivo
  negativo
}

Enum tipo_donacion {
  voluntaria
  reposicion
  autologa
}

Enum estado_donacion {
  registrada
  apta
  rechazada
}

Enum tipo_componente {
  sangre_total
  globulos_rojos
  plasma
  plaquetas
  crioprecipitado
}

Enum estado_unidad {
  disponible
  reservada
  despachada
  vencida
  descartada
}

Enum tipo_prueba {
  VIH
  HBV
  HCV
  sifilis
  chagas
  grupo_sanguineo
  pruebas_cruzadas
}

Enum resultado_prueba {
  negativo
  positivo
  pendiente
}

Enum estado_convenio {
  activo
  suspendido
}

Enum prioridad_solicitud {
  urgente
  programada
}

Enum estado_solicitud {
  pendiente
  parcial
  surtida
  cancelada
}

Enum estado_despacho {
  preparando
  en_transito
  entregado
  cancelado
}

Enum tipo_movimiento {
  entrada
  reserva
  liberacion
  salida
  descarte
  vencimiento
  ajuste
}

Enum accion_auditoria {
  INSERT
  UPDATE
  DELETE
}

// ==========================================
// 1. DONANTES
// ==========================================

Table donantes {
  id_donante int [pk, increment]
  nombre varchar(60) [not null]
  apellido_paterno varchar(60) [not null]
  apellido_materno varchar(60)
  fecha_nacimiento date [not null]
  sexo sexo [not null]
  tipo_sangre tipo_sangre [not null]
  factor_rh factor_rh [not null]
  telefono varchar(20)
  correo varchar(120) [unique]
  direccion varchar(160)
  fecha_registro datetime [not null, default: `CURRENT_TIMESTAMP`]
  activo tinyint [not null, default: 1]

  indexes {
    (tipo_sangre, factor_rh) [name: 'idx_donantes_tipo']
    activo [name: 'idx_donantes_activo']
  }
}

// ==========================================
// 2. DONACIONES
// ==========================================

Table donaciones {
  id_donacion int [pk, increment]
  id_donante int [not null]
  fecha_donacion datetime [not null]
  tipo_donacion tipo_donacion [not null, default: 'voluntaria']
  lugar varchar(80)
  peso_kg decimal(5,2)
  hemoglobina decimal(4,2)
  presion_arterial varchar(12)
  estado estado_donacion [not null, default: 'registrada']
  observaciones varchar(255)

  indexes {
    fecha_donacion [name: 'idx_donaciones_fecha']
    (id_donante, fecha_donacion) [name: 'idx_donaciones_donante']
  }
}

// ==========================================
// 3. UNIDADES DE SANGRE
// ==========================================

Table unidades_sangre {
  id_unidad int [pk, increment]
  id_donacion int [not null]
  codigo_barras varchar(40) [not null, unique]
  tipo_componente tipo_componente [not null]
  grupo_abo tipo_sangre [not null]
  factor_rh factor_rh [not null]
  volumen_ml int [not null]
  fecha_extraccion date [not null]
  fecha_vencimiento date [not null]
  estado estado_unidad [not null, default: 'disponible']
  ubicacion varchar(40)

  indexes {
    (estado, tipo_componente, fecha_vencimiento) [name: 'idx_unidades_disponibilidad']
    (grupo_abo, factor_rh, estado) [name: 'idx_unidades_grupo']
  }
}

// ==========================================
// 4. PRUEBAS DE LABORATORIO
// ==========================================

Table pruebas_laboratorio {
  id_prueba int [pk, increment]
  id_unidad int [not null]
  tipo_prueba tipo_prueba [not null]
  resultado resultado_prueba [not null, default: 'pendiente']
  fecha_prueba datetime [not null, default: `CURRENT_TIMESTAMP`]
  responsable varchar(80)
  observaciones varchar(255)

  indexes {
    (id_unidad, tipo_prueba) [name: 'idx_pruebas_unidad']
    (resultado, tipo_prueba) [name: 'idx_pruebas_resultado']
  }
}

// ==========================================
// 5. HOSPITALES
// ==========================================

Table hospitales {
  id_hospital int [pk, increment]
  nombre varchar(120) [not null]
  contacto varchar(80)
  telefono varchar(20)
  correo varchar(120)
  direccion varchar(160)
  convenio estado_convenio [not null, default: 'activo']

  indexes {
    convenio [name: 'idx_hospitales_convenio']
  }
}

// ==========================================
// 6. SOLICITUDES
// ==========================================

Table solicitudes {
  id_solicitud int [pk, increment]
  id_hospital int [not null]
  fecha_solicitud datetime [not null, default: `CURRENT_TIMESTAMP`]
  prioridad prioridad_solicitud [not null, default: 'programada']
  estado estado_solicitud [not null, default: 'pendiente']
  observaciones varchar(255)

  indexes {
    (estado, prioridad, fecha_solicitud) [name: 'idx_solicitudes_estado']
    (id_hospital, fecha_solicitud) [name: 'idx_solicitudes_hospital']
  }
}

// ==========================================
// 7. SOLICITUD DETALLE
// ==========================================

Table solicitud_detalle {
  id_detalle int [pk, increment]
  id_solicitud int [not null]
  tipo_componente tipo_componente [not null]
  grupo_abo tipo_sangre [not null]
  factor_rh factor_rh [not null]
  cantidad int [not null]

  indexes {
    id_solicitud [name: 'idx_solicitud_detalle']
    (tipo_componente, grupo_abo, factor_rh) [name: 'idx_solicitud_componente']
  }
}

// ==========================================
// 8. DESPACHOS
// ==========================================

Table despachos {
  id_despacho int [pk, increment]
  id_solicitud int [not null]
  fecha_despacho datetime [not null, default: `CURRENT_TIMESTAMP`]
  responsable varchar(80)
  destino varchar(160)
  estado estado_despacho [not null, default: 'preparando']

  indexes {
    fecha_despacho [name: 'idx_despachos_fecha']
    estado [name: 'idx_despachos_estado']
  }
}

// ==========================================
// 9. DETALLE DE DESPACHO
// ==========================================

Table despacho_detalle {
  id_despacho int [not null]
  id_unidad int [not null]

  indexes {
    (id_despacho, id_unidad) [pk]
  }
}

// ==========================================
// 10. MOVIMIENTOS DE INVENTARIO
// ==========================================

Table movimientos_inventario {
  id_movimiento bigint [not null, increment]
  id_unidad int [not null, note: 'Referencia logica a unidades_sangre. Sin FK fisica por particionamiento.']
  tipo_movimiento tipo_movimiento [not null]
  fecha_movimiento datetime [not null, default: `CURRENT_TIMESTAMP`]
  usuario varchar(80)
  motivo varchar(255)

  indexes {
    (id_movimiento, fecha_movimiento) [pk]
    (id_unidad, fecha_movimiento) [name: 'idx_movimientos_unidad']
    (tipo_movimiento, fecha_movimiento) [name: 'idx_movimientos_tipo']
  }

  Note: 'Tabla particionada por YEAR(fecha_movimiento). Particiones p2024, p2025, p2026, p2027 y pmax.'
}

// ==========================================
// 11. AUDITORIA DE UNIDADES
// ==========================================

Table auditoria_unidades {
  id_auditoria bigint [pk, increment]
  id_unidad int [not null, note: 'Referencia logica a unidades_sangre']
  accion accion_auditoria [not null]
  usuario varchar(80) [not null]
  fecha datetime [not null, default: `CURRENT_TIMESTAMP`]
  datos_anteriores json
  datos_nuevos json

  indexes {
    (id_unidad, fecha) [name: 'idx_auditoria_unidad']
    fecha [name: 'idx_auditoria_fecha']
  }
}

// ==========================================
// 12. BITACORA DE DISPONIBILIDAD
// ==========================================

Table bitacora_disponibilidad {
  id_registro bigint [pk, increment]
  fecha_registro datetime [not null, default: `CURRENT_TIMESTAMP`]
  uptime_seg bigint [not null]

  indexes {
    fecha_registro [name: 'idx_bitacora_fecha']
  }
}

// ==========================================
// 13. VISTA DE UNIDADES DISPONIBLES
// Representacion visual de una VIEW, no tabla fisica.
// ==========================================

Table v_unidades_disponibles {
  id_unidad int
  codigo_barras varchar(40)
  tipo_componente tipo_componente
  grupo_abo tipo_sangre
  factor_rh factor_rh
  volumen_ml int
  fecha_vencimiento date
  dias_para_vencer int

  Note: 'VIEW: solo unidades disponibles y no vencidas. Calcula dias_para_vencer con DATEDIFF.'
}

// ==========================================
// RELACIONES (FOREIGN KEYS)
// ==========================================

Ref fk_donacion_donante:
  donaciones.id_donante > donantes.id_donante

Ref fk_unidad_donacion:
  unidades_sangre.id_donacion > donaciones.id_donacion

Ref fk_prueba_unidad:
  pruebas_laboratorio.id_unidad > unidades_sangre.id_unidad

Ref fk_solicitud_hospital:
  solicitudes.id_hospital > hospitales.id_hospital

Ref fk_detalle_solicitud:
  solicitud_detalle.id_solicitud > solicitudes.id_solicitud

Ref fk_despacho_solicitud:
  despachos.id_solicitud > solicitudes.id_solicitud

Ref fk_despacho_detalle_despacho:
  despacho_detalle.id_despacho > despachos.id_despacho

Ref fk_despacho_detalle_unidad:
 
