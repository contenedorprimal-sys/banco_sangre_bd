Project banco_sangre {
  database_type: 'MySQL'
  Note: '''
    Banco de Sangre · esquema de la Unidad 1 (12 tablas).
    Motor: MySQL 8 InnoDB. Fuente: sql/00_esquema.sql.

    No representa la vista v_unidades_disponibles ni las particiones,
    porque DBML no modela vistas ni particionamiento. Ver README.md.
    movimientos_inventario.id_unidad y auditoria_unidades.id_unidad son
    referencias lógicas sin FK física.
  '''
}

// ---------------------------------------------------------------------------
// Catálogos y enums compartidos
// ---------------------------------------------------------------------------

enum sexo {
  F
  M
  X
}

enum grupo_abo {
  A
  B
  AB
  O
}

enum factor_rh {
  "+"
  "-"
}

enum tipo_donacion {
  voluntaria
  reposicion
  autologa
}

enum estado_donacion {
  registrada
  apta
  rechazada
}

enum tipo_componente {
  sangre_total
  globulos_rojos
  plasma
  plaquetas
  crioprecipitado
}

enum estado_unidad {
  disponible
  reservada
  despachada
  vencida
  descartada
}

enum tipo_prueba {
  VIH
  HBV
  HCV
  sifilis
  chagas
  grupo_sanguineo
  pruebas_cruzadas
}

enum resultado_prueba {
  negativo
  positivo
  pendiente
}

enum convenio {
  activo
  suspendido
}

enum prioridad_solicitud {
  urgente
  programada
}

enum estado_solicitud {
  pendiente
  parcial
  surtida
  cancelada
}

enum estado_despacho {
  preparando
  en_transito
  entregado
  cancelado
}

enum tipo_movimiento {
  entrada
  reserva
  liberacion
  salida
  descarte
  vencimiento
  ajuste
}

enum accion_auditoria {
  INSERT
  UPDATE
  DELETE
}

// ---------------------------------------------------------------------------
// Núcleo: donantes → donaciones → unidades → pruebas
// ---------------------------------------------------------------------------

Table donantes {
  id_donante       integer      [pk, increment]
  nombre           varchar(60)  [not null]
  apellido_paterno varchar(60)  [not null]
  apellido_materno varchar(60)
  fecha_nacimiento date         [not null]
  sexo             sexo         [not null]
  tipo_sangre      grupo_abo    [not null]
  factor_rh        factor_rh    [not null]
  telefono         varchar(20)
  correo           varchar(120) [unique]
  direccion        varchar(160)
  fecha_registro   datetime     [not null, default: `CURRENT_TIMESTAMP`]
  activo           tinyint      [not null, default: 1]

  indexes {
    (tipo_sangre, factor_rh) [name: 'idx_donantes_tipo']
    activo                   [name: 'idx_donantes_activo']
  }

  checks {
    `fecha_nacimiento >= '1900-01-01'` [name: 'chk_donante_nacimiento']
  }

  Note: 'Personas que donan. Sin diagnóstico clínico; solo contacto, elegibilidad y clasificación sanguínea.'
}

Table donaciones {
  id_donacion      integer        [pk, increment]
  id_donante       integer        [not null]
  fecha_donacion   datetime       [not null]
  tipo_donacion    tipo_donacion  [not null, default: 'voluntaria']
  lugar            varchar(80)
  peso_kg          decimal(5,2)
  hemoglobina      decimal(4,2)
  presion_arterial varchar(12)
  estado           estado_donacion [not null, default: 'registrada']
  observaciones    varchar(255)

  indexes {
    fecha_donacion            [name: 'idx_donaciones_fecha']
    (id_donante, fecha_donacion) [name: 'idx_donaciones_donante']
  }

  checks {
    `peso_kg IS NULL OR peso_kg > 0` [name: 'chk_donacion_peso']
  }

  Note: 'Cada extracción. Una donación puede originar varias unidades/componentes.'
}

Table unidades_sangre {
  id_unidad         integer          [pk, increment]
  id_donacion       integer          [not null]
  codigo_barras     varchar(40)      [not null, unique, note: 'Identificador trazable de la unidad']
  tipo_componente   tipo_componente  [not null]
  grupo_abo         grupo_abo        [not null]
  factor_rh         factor_rh        [not null]
  volumen_ml        integer          [not null]
  fecha_extraccion  date             [not null]
  fecha_vencimiento date             [not null]
  estado            estado_unidad    [not null, default: 'disponible']
  ubicacion         varchar(40)

  indexes {
    (estado, tipo_componente, fecha_vencimiento) [name: 'idx_unidades_disponibilidad']
    (grupo_abo, factor_rh, estado)               [name: 'idx_unidades_grupo']
  }

  checks {
    `volumen_ml > 0`                              [name: 'chk_unidad_volumen']
    `fecha_vencimiento >= fecha_extraccion`       [name: 'chk_unidad_fechas']
  }

  Note: 'Inventario real. Vencimiento según componente: GR 35–42 días, plasma ~1 año, plaquetas 5–7 días.'
}

Table pruebas_laboratorio {
  id_prueba     integer         [pk, increment]
  id_unidad     integer         [not null]
  tipo_prueba   tipo_prueba     [not null]
  resultado     resultado_prueba [not null, default: 'pendiente']
  fecha_prueba  datetime        [not null, default: `CURRENT_TIMESTAMP`]
  responsable   varchar(80)
  observaciones varchar(255)

  indexes {
    (id_unidad, tipo_prueba)   [name: 'idx_pruebas_unidad']
    (resultado, tipo_prueba)   [name: 'idx_pruebas_resultado']
  }

  Note: 'Tamizaje obligatorio (VIH, HBV, HCV, sífilis, Chagas, grupo y pruebas cruzadas).'
}

// ---------------------------------------------------------------------------
// Atención hospitalaria: solicitudes → despachos
// ---------------------------------------------------------------------------

Table hospitales {
  id_hospital integer      [pk, increment]
  nombre      varchar(120) [not null]
  contacto    varchar(80)
  telefono    varchar(20)
  correo      varchar(120)
  direccion   varchar(160)
  convenio    convenio     [not null, default: 'activo']

  indexes {
    convenio [name: 'idx_hospitales_convenio']
  }

  Note: 'Clientes institucionales con convenio.'
}

Table solicitudes {
  id_solicitud    integer            [pk, increment]
  id_hospital     integer            [not null]
  fecha_solicitud datetime           [not null, default: `CURRENT_TIMESTAMP`]
  prioridad       prioridad_solicitud [not null, default: 'programada']
  estado          estado_solicitud   [not null, default: 'pendiente']
  observaciones   varchar(255)

  indexes {
    (estado, prioridad, fecha_solicitud) [name: 'idx_solicitudes_estado']
    (id_hospital, fecha_solicitud)       [name: 'idx_solicitudes_hospital']
  }

  Note: 'Pedido de un hospital; la prioridad cambia el orden de atención.'
}

Table solicitud_detalle {
  id_detalle      integer          [pk, increment]
  id_solicitud    integer          [not null]
  tipo_componente tipo_componente  [not null]
  grupo_abo       grupo_abo        [not null]
  factor_rh       factor_rh        [not null]
  cantidad        integer          [not null]

  indexes {
    id_solicitud                              [name: 'idx_solicitud_detalle']
    (tipo_componente, grupo_abo, factor_rh)   [name: 'idx_solicitud_componente']
  }

  checks {
    `cantidad > 0` [name: 'chk_detalle_cantidad']
  }

  Note: 'Qué componente y cuántas unidades pide cada solicitud.'
}

Table despachos {
  id_despacho    integer         [pk, increment]
  id_solicitud   integer         [not null]
  fecha_despacho datetime        [not null, default: `CURRENT_TIMESTAMP`]
  responsable    varchar(80)
  destino        varchar(160)
  estado         estado_despacho [not null, default: 'preparando']

  indexes {
    fecha_despacho [name: 'idx_despachos_fecha']
    estado         [name: 'idx_despachos_estado']
  }

  Note: 'Salida física de unidades hacia un hospital.'
}

Table despacho_detalle {
  id_despacho integer [not null]
  id_unidad   integer [not null]

  indexes {
    (id_despacho, id_unidad) [pk]
  }

  Note: 'Unidades concretas entregadas en cada despacho.'
}

// ---------------------------------------------------------------------------
// Operación: historial, auditoría y disponibilidad
// ---------------------------------------------------------------------------

Table movimientos_inventario {
  id_movimiento    bigint          [not null, increment]
  id_unidad        integer         [not null, note: 'Referencia lógica, sin FK física']
  tipo_movimiento  tipo_movimiento [not null]
  fecha_movimiento datetime        [not null, default: `CURRENT_TIMESTAMP`]
  usuario          varchar(80)
  motivo           varchar(255)

  indexes {
    (id_movimiento, fecha_movimiento) [pk]
    (id_unidad, fecha_movimiento)     [name: 'idx_movimientos_unidad']
    (tipo_movimiento, fecha_movimiento) [name: 'idx_movimientos_tipo']
  }

  Note: 'Historial particionado por RANGE (YEAR(fecha_movimiento)). Sin FK por regla de MySQL.'
}

Table auditoria_unidades {
  id_auditoria     bigint            [pk, increment]
  id_unidad        integer           [not null, note: 'Referencia lógica; la llena un trigger']
  accion           accion_auditoria  [not null]
  usuario          varchar(80)       [not null]
  fecha            datetime          [not null, default: `CURRENT_TIMESTAMP`]
  datos_anteriores json
  datos_nuevos     json

  indexes {
    (id_unidad, fecha) [name: 'idx_auditoria_unidad']
    fecha              [name: 'idx_auditoria_fecha']
  }

  Note: 'Evidencia de cambios sensibles sobre unidades_sangre (triggers).'
}

Table bitacora_disponibilidad {
  id_registro    bigint   [pk, increment]
  fecha_registro datetime [not null, default: `CURRENT_TIMESTAMP`]
  uptime_seg     bigint   [not null]

  indexes {
    fecha_registro [name: 'idx_bitacora_fecha']
  }

  Note: 'Snapshots horarios del Uptime del servidor para monitoreo.'
}

// ---------------------------------------------------------------------------
// Relaciones (mismas acciones que el DDL)
// ---------------------------------------------------------------------------

Ref fk_donacion_donante: donaciones.id_donante > donantes.id_donante [delete: restrict, update: cascade]

Ref fk_unidad_donacion: unidades_sangre.id_donacion > donaciones.id_donacion [delete: cascade, update: cascade]

Ref fk_prueba_unidad: pruebas_laboratorio.id_unidad > unidades_sangre.id_unidad [delete: cascade, update: cascade]

Ref fk_solicitud_hospital: solicitudes.id_hospital > hospitales.id_hospital [delete: restrict, update: cascade]

Ref fk_detalle_solicitud: solicitud_detalle.id_solicitud > solicitudes.id_solicitud [delete: cascade, update: cascade]

Ref fk_despacho_solicitud: despachos.id_solicitud > solicitudes.id_solicitud [delete: restrict, update: cascade]

Ref fk_despacho_detalle_despacho: despacho_detalle.id_despacho > despachos.id_despacho [delete: cascade, update: cascade]

Ref fk_despacho_detalle_unidad: despacho_detalle.id_unidad > unidades_sangre.id_unidad [delete: restrict, update: cascade]

// ---------------------------------------------------------------------------
// Agrupación para dbdiagram.io
// ---------------------------------------------------------------------------

TableGroup nucleo_sangre {
  donantes
  donaciones
  unidades_sangre
  pruebas_laboratorio
}

TableGroup atencion_hospitalaria {
  hospitales
  solicitudes
  solicitud_detalle
  despachos
  despacho_detalle
}

TableGroup operacion_auditoria {
  movimientos_inventario
  auditoria_unidades
  bitacora_disponibilidad
}
